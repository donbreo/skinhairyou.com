# Cloudflare Tunnel runs on this same server and connects over loopback.
HOST=127.0.0.1
PORT=12207
TRUST_PROXY=loopback

# If cloudflared runs in a container or on another host, do not use
# TRUST_PROXY=loopback; set it to the exact trusted proxy IP/subnet instead.
# The proxy must overwrite incoming X-Forwarded-* headers.
